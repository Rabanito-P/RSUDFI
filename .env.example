# ==============================================================================
# UNDC RSU — .env.example — Docker Compose + PostgreSQL 18
# Copia a .env :  cp .env.example .env   (.env NO se sube al repositorio)
#
# En Dokploy: configura estas mismas variables en el panel de entorno del
# servicio (Environment). El compose las referencia con ${VAR} y NUNCA trae
# valores por defecto para los secretos.
# ==============================================================================

# ── Base de datos PostgreSQL 18 (red interna de Docker) ──
POSTGRES_USER=undc
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=undc_rsu

# Puertos host (solo backend y frontend; el DB no se publica)
BACKEND_PORT=8080
FRONTEND_PORT=5173

# ── Backend Go / Gin ──
# release = producción: JWT_SECRET es OBLIGATORIA (mínimo 32 caracteres)
GIN_MODE=release
# Genera uno con:  openssl rand -base64 32
JWT_SECRET=

# Orígenes CORS del navegador, separados por coma (vacío = solo dev, acepta todo)
CORS_ORIGINS=https://tu-dominio.com

# Frontend — deja vacío para usar proxy relativo /api → backend via nginx
VITE_API_URL=

# ── Almacenamiento: local (volumen) o b2 (Backblaze B2, bucket privado) ──
STORAGE_DRIVER=local
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=

# ── Correos transaccionales (Resend) ──
RESEND_API_KEY=
EMAIL_FROM=UNDC RSU <onboarding@resend.dev>
EMAIL_REPLY_TO=
FRONTEND_URL=https://tu-dominio.com
