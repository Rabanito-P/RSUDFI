# ==============================================================================
# UNDC RSU - .env - Docker Compose + PostgreSQL 18
# Copia a .env :  cp .env.example .env  (opcional, los defaults ya estan en compose)
# ==============================================================================
# Base de datos PostgreSQL 18
POSTGRES_USER=undc
POSTGRES_PASSWORD=undc2026
POSTGRES_DB=undc_rsu
POSTGRES_PORT=5432

# Puertos host
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Backend Go / Gin
GIN_MODE=release
JWT_SECRET=Gbu0E1Ll2DivBIaHdwW8PqTjM4AZkrfO967xmtCspXRoJz3Y

# Frontend - deja vacio para usar proxy relativo /api -> backend via nginx
# Si quieres que Vite llame directo al backend: VITE_API_URL=http://localhost:8080
VITE_API_URL=

# Uploads (dentro del contenedor)
UPLOAD_DIR=/app/uploads
TZ=America/Lima
# Origenes permitidos para el navegador. Vacio = se acepta cualquiera (solo desarrollo).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ── Almacenamiento Backblaze B2 (API nativa, bucket privado) ──
# DESACTIVADO durante las pruebas para no agotar la cuota del servicio.
# Para reactivarlo: STORAGE_DRIVER=b2 + credenciales válidas.
STORAGE_DRIVER=local
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=

# ── Correos transaccionales (Resend) ──
# DESACTIVADO durante las pruebas para no agotar la cuota del servicio.
# Sin RESEND_API_KEY el backend solo registra los envíos en el log.
RESEND_API_KEY=
EMAIL_FROM=UNDC RSU <onboarding@resend.dev>
EMAIL_REPLY_TO=
FRONTEND_URL=http://localhost:5173
