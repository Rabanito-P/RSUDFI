# ==============================================================================
# UNDC RSU — .env — Docker Compose + PostgreSQL 18
# Copia a .env :  cp .env.example .env  (opcional, los defaults ya están en compose)
# ==============================================================================
# Base de datos PostgreSQL 18
POSTGRES_USER=undc
POSTGRES_PASSWORD=undc2026
POSTGRES_DB=undc_rsu
POSTGRES_PORT=5432

# Puertos host
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Backend Go / Gin
GIN_MODE=release
JWT_SECRET=Gbu0E1Ll2DivBIaHdwW8PqTjM4AZkrfO967xmtCspXRoJz3Y

# Frontend — deja vacío para usar proxy relativo /api → backend via nginx
# Si quieres que Vite llame directo al backend: VITE_API_URL=http://localhost:8080
VITE_API_URL=

# Uploads (dentro del contenedor)
UPLOAD_DIR=/app/uploads
TZ=America/Lima
# Orígenes permitidos para el navegador. Vacío = se acepta cualquiera (solo desarrollo).
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
