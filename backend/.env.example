PORT=8080
GIN_MODE=release
# PostgreSQL 18 — dentro de docker el host es 'postgres', fuera '127.0.0.1'
DB_HOST=postgres
DB_PORT=5432
DB_USER=undc
DB_PASS=undc2026
DB_NAME=undc_rsu
JWT_SECRET=undc-rsu-super-secret-2026
UPLOAD_DIR=./uploads
# ── MVP modular: auth + storage ──
# Auth: mock activo (usuarios rápidos). OAuth PRESENTE pero DESACTIVADO.
AUTH_MODE=mock
# OAUTH_ISSUER=https://login.undc.edu.pe/realms/rsu
# OAUTH_CLIENT_ID=rsu-facultad
# OAUTH_CLIENT_SECRET=cambiar-en-produccion
# OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
# Storage: local activo. Cloud S3 PRESENTE pero DESACTIVADO.
STORAGE_DRIVER=local
# S3_ENDPOINT=https://s3.undc.edu.pe
# S3_BUCKET=rsu-uploads
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Para desarrollo local sin Docker, usa:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# y ejecuta: docker compose up postgres -d ; go run ./cmd/server

# ── Almacenamiento de archivos (V2) ──
# local = disco (UPLOAD_DIR) · b2 = Backblaze B2 API NATIVA (bucket PRIVADO).
# Con b2 los archivos se sirven por GET /api/v1/archivos?key=... (con token):
# nunca se exponen URLs publicas del bucket. Credenciales: ID de clave
# (accountID) + applicationKey + ID del bucket, desde la consola de Backblaze.
STORAGE_DRIVER=local
# B2_ACCOUNT_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET_ID=
# ── Correos transaccionales (Resend) ──
# Sin dominio verificado, enviar solo desde onboarding@resend.dev.
# RESEND_API_KEY=
# EMAIL_FROM=UNDC RSU <onboarding@resend.dev>
# EMAIL_REPLY_TO=
# FRONTEND_URL=http://localhost:5173 (URL publica del front para los botones de los correos)