# ==============================================================================
# UNDC RSU - backend/.env - configuracion local del backend Go (Docker Compose
# la toma con env_file; las claves de B2/Resend se versionan a proposito
# segun la politica de .gitignore del repo, igual que el .env raiz).
# ==============================================================================

PORT=8080
GIN_MODE=release
# PostgreSQL: en Docker el host es 'postgres' (lo fija compose); en local 127.0.0.1
DB_HOST=postgres
DB_PORT=5432
DB_USER=undc
DB_PASS=undc2026
DB_NAME=undc_rsu
JWT_SECRET=undc-rsu-super-secret-2026
UPLOAD_DIR=/app/uploads
TZ=America/Lima

# ── Almacenamiento de archivos ─────────────────────────────────
# local = disco del contenedor (volumen backend_uploads)
# b2    = Backblaze B2 API NATIVA (bucket PRIVADO). Las descargas se sirven
#        por GET /api/v1/archivos?key=... con autenticacion (nunca URL publica).
#        Credenciales de la consola B2: ID de clave (accountID) + applicationKey
#        + ID del bucket.
STORAGE_DRIVER=b2
B2_ACCOUNT_ID=6c259361bdad
B2_APPLICATION_KEY=00501151c510951b491efe1bb478e0a521b2488bea
B2_BUCKET_ID=f64c72b539a346e19bfd0a1d

# ── Correos transaccionales (Resend) ───────────────────────────
# Sin dominio propio verificado, Resend solo permite enviar desde
# onboarding@resend.dev. Cambia EMAIL_FROM cuando verifiques tu dominio.
RESEND_API_KEY=re_8dm8yh6z_3w8mLpEJGrKKmjhrThqx1qK3
EMAIL_FROM=UNDC RSU <onboarding@resend.dev>
EMAIL_REPLY_TO=
# URL publica del front (para los botones de los correos)
FRONTEND_URL=http://localhost:5173
